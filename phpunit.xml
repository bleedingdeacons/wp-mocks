<?xml version="1.0" encoding="UTF-8"?>
<!--
    Deliberately minimal, and deliberately free of any attribute that exists in
    only one PHPUnit major version. This package's whole selling point is that
    it does not pin PHPUnit, so its own suite is run against 10.5, 11 and 12 in
    CI and this config has to be valid for all three.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">

    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
